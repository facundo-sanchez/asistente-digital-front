# Copiar a .env.local y completar.

# URL interna del backend (Quarkus), incluido el root-path. Solo la usa el servidor de Next (BFF);
# nunca llega al navegador.
API_BACKEND=http://localhost:8080/asistente-digital-back/api/v1

# Prefijo de la app si se publica bajo una subruta (ej. /mi-balance). Vacío = raíz.
# Se aplica en build: cambiarlo requiere volver a compilar.
# Si se usa, el FRONTEND_URL del backend tiene que incluirlo (los links de los emails
# apuntan a FRONTEND_URL + /verify-email, /reset-password).
NEXT_PUBLIC_BASE_PATH=

# Cookies de sesión solo por HTTPS. Por defecto: true en producción, false en desarrollo.
# Poner false SOLO en despliegues internos sin TLS (http://192.168.x.x).
# COOKIE_SECURE=true
